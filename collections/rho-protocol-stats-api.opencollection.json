{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rho Exchange Market Data Stats API",
    "version": "development"
  },
  "items": [
    {
      "info": {
        "name": "Stats",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve volume stats",
