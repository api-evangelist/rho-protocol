            "params": [
              {
                "name": "startTime",
                "value": "",
                "type": "query",
                "description": "Start time (ISO8601 / RFC3339)"
              },
              {
                "name": "endTime",
                "value": "",
                "type": "query",
                "description": "End time (ISO8601 / RFC3339)"
              }
            ]
          },
          "docs": "Returns volume stats for a given timeframe"
        }
      ]
    }
  ],
  "bundled": true
}